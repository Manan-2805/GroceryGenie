FROM python:3.12-slim

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Install uv
RUN pip install uv

WORKDIR /app

# Enable virtualenv creation in the container
ENV UV_PROJECT_ENVIRONMENT=/app/.venv

# Copy pyproject.toml and uv.lock first for caching
COPY pyproject.toml uv.lock ./

# Install dependencies without installing the project itself and prune heavy unused wheels
RUN uv sync --frozen --no-install-project && \
    rm -rf /app/.venv/lib/python3.12/site-packages/triton* && \
    rm -rf /app/.venv/lib/python3.12/site-packages/nvidia/nccl* && \
    rm -rf /app/.venv/lib/python3.12/site-packages/nvidia/nvshmem* && \
    rm -rf /app/.venv/lib/python3.12/site-packages/nvidia/cusparselt* && \
    find /app/.venv/lib/python3.12/site-packages/nvidia/ -name "libcusolver.so*" -delete && \
    find /app/.venv/lib/python3.12/site-packages/nvidia/ -name "libcusparse.so*" -delete && \
    find /app/.venv/lib/python3.12/site-packages/nvidia/ -name "libcufft.so*" -delete && \
    find /app/.venv/lib/python3.12/site-packages/nvidia/ -name "libnvrtc.so*" -delete

# Copy the rest of the application
COPY . .

# Run the backend using uvicorn with reload
CMD ["/app/.venv/bin/uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--reload-dir", "app"]
