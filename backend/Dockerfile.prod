# syntax=docker/dockerfile:1
FROM ghcr.io/astral-sh/uv:0.13.9 AS uv
FROM cgr.dev/chainguard/wolfi-base@sha256:28c39be5a5e1e9b85081c10740e8495f6518a865b23bc6a486637c4b21e74b43 AS python
RUN apk add --no-cache python-3.12=3.12.16-r3 libstdc++=16.2.0-r5
WORKDIR /app

FROM python AS build
ENV UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never UV_PYTHON=/usr/bin/python3.12
COPY --from=uv /uv /usr/local/bin/uv
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --locked --no-dev --no-install-project

FROM python AS runtime
LABEL org.opencontainers.image.source="https://github.com/Manan-2805/GroceryGenie"
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN addgroup -g 10001 grocery && adduser -D -H -u 10001 -G grocery grocery && \
    mkdir -p /app/uploads /app/models && chown 10001:10001 /app/uploads /app/models
COPY --from=build /app/.venv /app/.venv
COPY app/ ./app/
COPY alembic.ini ./
USER 10001:10001
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--ws-max-size", "8192", "--ws-max-queue", "4", "--no-access-log"]
