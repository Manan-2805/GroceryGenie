# Stage 1: Build dependencies
FROM python:3.12-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv via official install script
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

WORKDIR /app

ENV UV_PROJECT_ENVIRONMENT=/app/.venv \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1

# Copy dependency manifests only
COPY pyproject.toml uv.lock ./

# Install production dependencies only (--no-dev excludes bandit, mypy, pytest, playwright)
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev && \
    rm -rf /app/.venv/lib/python3.12/site-packages/triton* && \
    rm -rf /app/.venv/lib/python3.12/site-packages/nvidia/nccl* && \
    rm -rf /app/.venv/lib/python3.12/site-packages/nvidia/nvshmem* && \
    rm -rf /app/.venv/lib/python3.12/site-packages/nvidia/cusparselt* && \
    find /app/.venv/lib/python3.12/site-packages/nvidia/ -name "libcusolver.so*" -delete 2>/dev/null || true && \
    find /app/.venv/lib/python3.12/site-packages/nvidia/ -name "libcusparse.so*" -delete 2>/dev/null || true && \
    find /app/.venv/lib/python3.12/site-packages/nvidia/ -name "libcufft.so*" -delete 2>/dev/null || true && \
    find /app/.venv/lib/python3.12/site-packages/nvidia/ -name "libnvrtc.so*" -delete 2>/dev/null || true

# Stage 2: Lean runtime image
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the compiled venv from builder
COPY --from=builder /app/.venv /app/.venv

# Copy only the application source (not tests, docs, dev tools)
COPY app/ ./app/
COPY alembic.ini ./

EXPOSE 8000

ENV PATH="/app/.venv/bin:$PATH"

CMD ["/app/.venv/bin/python", "-B", "-m", "app.prestart", "granian", "--interface", "asgi", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
