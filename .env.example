# Copy to .env and set separate random hex values for the local database and session key.
POSTGRES_PASSWORD=
SESSION_SIGNING_KEY=
# Google OAuth Web application. Register the exact redirect URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080
ENV_MODE=development
# Use the Moonshot Open Platform API key inside this JSON array to enable cloud planning.
LLM_PROVIDERS=
# LLM_PROVIDERS='[{"name":"moonshot","base_url":"https://api.moonshot.ai/v1","model":"kimi-k3","api_key":"REPLACE_WITH_MOONSHOT_API_KEY","json_object":true,"reasoning_effort":"low","token_limit_field":"max_completion_tokens","timeout":8,"input_usd_per_million":3,"output_usd_per_million":15}]'
