# Database config
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/grocergenie

# Redis config
REDIS_URL=redis://redis:6379/0
CHAT_SESSION_TTL_SECONDS=3600

# Qdrant config
QDRANT_URL=http://qdrant:6333

# Neo4j config
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=grocergeniepass

# LLM Orchestrator (NVIDIA NIM / OpenAI compatible API)
NIM_API_KEY=your_nim_api_key
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.1-70b-instruct

# Ollama (local LLM provider - OpenAI compatible)
OLLAMA_API_KEY=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# Kimi (Moonshot AI)
KIMI_API_KEY=your_kimi_api_key
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6

# Multi-provider LLM configuration (JSON list)
# Supports NIM, Ollama, Kimi, and any OpenAI-compatible provider.
# Providers are tried in order: fallback happens on timeout/auth failure.
# Temperature-restricted models (e.g. kimi-k2.6) are forced to temp=1.0 automatically.
#
# Example:
# LLM_PROVIDERS=[{"name":"kimi","api_key":"sk-...","base_url":"https://api.moonshot.cn/v1","model":"kimi-k2.6","type":"primary","temperature":1.0,"timeout":60.0},{"name":"nvidia","api_key":"nvapi-...","base_url":"https://integrate.api.nvidia.com/v1","model":"meta/llama-3.1-70b-instruct","type":"primary","temperature":0.3,"timeout":60.0},{"name":"ollama","api_key":"ollama","base_url":"http://localhost:11434/v1","model":"llama3.1","type":"primary","temperature":0.3,"timeout":60.0}]

# Google OAuth credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# JWT Auth config
JWT_SECRET_KEY=your_jwt_secret_key_change_me_in_production

# Voice Services config
PIPER_VOICE_MODEL=/app/models/en_US-lessac-medium.onnx
PIPER_VOICE_CONFIG=/app/models/en_US-lessac-medium.onnx.json
ONNX_ASR_PROVIDERS=CPUExecutionProvider
PARAKEET_CHUNK_SECONDS=5

# Embedding model config
EMBEDDING_MODEL_PATH=BAAI/bge-small-en-v1.5

# Server config
GRANIAN_WORKERS=1
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=60
ENV_MODE=development